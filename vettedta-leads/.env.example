# Frontend (exposed to the browser — safe to be public)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- The variables below are NOT used by the frontend build. ---
# They are consumed by Supabase Edge Functions and must be set as
# Supabase function secrets (never bundled into the client app):
#   supabase secrets set SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=... BING_API_KEY=...
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BING_API_KEY=your-bing-search-v7-api-key
